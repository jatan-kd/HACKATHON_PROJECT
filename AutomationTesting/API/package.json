{
  "name": "<inject_variable_github_repo_name>_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:reports": "rm -rf cypress\\reports && mkdir cypress\\reports && mkdir cypress\\reports\\mochareports",
    "pretest": "npm run clean:reports",
    "cy:run": "cypress run",
    "combine-reports": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/mochareports/report.json",
    "generate-report": "marge cypress/reports/mochareports/report.json -f report -o cypress/reports/mochareports",
    "posttest": "npm run combine-reports && npm run generate-report",
    "test": "npm run cy:run || npm run posttest",
    "cy:open": "npx cypress open",
    "e": "code --install-extension alexkrechik.cucumberautocomplete  "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEP-GitHub"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://smartbygep.atlassian.net/jira/software/c/projects/GBCF/boards/811"
  },
  "devDependencies": {
    "@types/node": "^18.15.7",
    "cypress": "12.8.1",
    "cypress-cucumber-preprocessor": "4.3.1",
    "cypress-multi-reporters": "1.6.3",
    "mocha": "8.2.1",
    "mocha-junit-reporter": "2.0.2",
    "mochawesome": "6.2.1",
    "mochawesome-merge": "4.2.0",
    "mochawesome-report-generator": "5.1.0",
    "tsify": "5.0.2",
    "typescript": "4.1.3"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true
  }
}
